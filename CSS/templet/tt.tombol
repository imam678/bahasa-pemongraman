


.subscribe-button {
    background-color: rgb(255, 0, 0);
    color: white;
    border: none;
    height: 36px;
    width: 105px;
    border-radius: 3px;
    cursor: pointer;
  }

  /* value :hover buat klik cursor warna hijau */
  .subscribe-button:hover {
    opacity: 0.7;
  }

  /* aktif ketika di klik cursor */
  .subscribe-button:active {
    opacity: 0.4;
  }

  ----------     -------

  // klik teransisison sederhanan
  .subscribe-button:hover {
    background-color: blue;
  }

  // klik teransision sederhanan
  .subscribe-button:active {
    background-color: green; 
  }






