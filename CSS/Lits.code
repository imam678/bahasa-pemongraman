margin: 0;
min-height: 100vh;
background: rgba(147, 147, 202, 0.467);
position: relative;
overflow: auto;




position: absolute;
width: 400px;
height: 100px;
background-color: hsl(180, 100%, 50%);
border-radius: 16px;
user-select: none;
top: 50%;
left: 50%;
transform: translate(-50%, -50%)




cursor: grabbing;
cursor: grab;






