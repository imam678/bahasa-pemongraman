
margin  [ ruang di sekitar  ]              background [ latar-belakang ]            top [ atas ] 
          elemen                           border-radius [ bentuk lengkung ]        left [ kiri ]
min-height [ minimal tinggi ]                                                       buttom [ bawah ]   
height [ tinggi ]                                                                   right [ kanan ]
